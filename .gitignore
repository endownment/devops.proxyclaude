# secrets
.env.local

# local Compose override (machine-specific settings, created from docker-compose.override.example.yml)
docker-compose.override.yml

# contents of the mounted folders (the folders themselves are kept via .gitkeep)
projects/*
!projects/.gitkeep

data/sdkman/*
!data/sdkman/.gitkeep
data/m2/*
!data/m2/.gitkeep
data/gradle/*
!data/gradle/.gitkeep
data/zsh/*
!data/zsh/.gitkeep
.claude/*
!.claude/.gitkeep
